{
    "name": "pierre-arthur/sylius-upgrade-analyzer",
    "description": "Outil CLI d'audit automatisé de migration pour projets Sylius 1.x vers 2.x",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Pierre-Arthur Demengel",
            "email": "pierrearthur.demengel@gmail.com",
            "homepage": "https://creation-site-pro.fr/",
            "role": "Developer"
        }
    ],
    "keywords": [
        "sylius",
        "migration",
        "upgrade",
        "audit",
        "static-analysis",
        "php"
    ],
    "homepage": "https://creation-site-pro.fr/en/sylius-2-upgrade?utm_source=analyzer-packagist",
    "support": {
        "issues": "https://github.com/pierrearthurdemengel/sylius-upgrade-analyzer/issues",
        "source": "https://github.com/pierrearthurdemengel/sylius-upgrade-analyzer"
    },
    "require": {
        "php": ">=8.2",
        "ext-dom": "*",
        "nikic/php-parser": "^5.0",
        "symfony/console": "^6.4|^7.2",
        "symfony/finder": "^6.4|^7.2",
        "symfony/http-client": "^6.4|^7.2",
        "symfony/yaml": "^6.4.45|^7.4.18"
    },
    "require-dev": {
        "dompdf/dompdf": "^3.1",
        "friendsofphp/php-cs-fixer": "^3.0",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.0",
        "symfony/framework-bundle": "^6.4|^7.2",
        "symfony/http-client-contracts": "^3.0"
    },
    "suggest": {
        "dompdf/dompdf": "Requis pour générer les rapports au format PDF (--format=pdf)"
    },
    "autoload": {
        "psr-4": {
            "PierreArthur\\SyliusUpgradeAnalyzer\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PierreArthur\\SyliusUpgradeAnalyzer\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/sylius-upgrade-analyzer"
    ],
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
